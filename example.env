PORT=5001
# Connection string without credentials, e.g. mongodb+srv://cluster0.example.mongodb.net/tasktracker?retryWrites=true
MONGODB_URL=
# Raw (unencoded) credentials; they are URL-encoded when connecting. Leave both empty to use MONGODB_URL as-is.
MONGODB_USERNAME=
MONGODB_PASSWORD=
APP_URL=http://localhost:5173
SERVER_URL=http://localhost:5001
GMAIL_ID=
GMAIL_PASSWORD=
JWT_TOKEN_SECRET=