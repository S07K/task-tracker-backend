PORT=5001
# Connection string without credentials, e.g. mongodb+srv://cluster0.example.mongodb.net/tasktracker?retryWrites=true
MONGODB_URL=
# Raw (unencoded) credentials; they are URL-encoded when connecting. Leave both empty to use MONGODB_URL as-is.
MONGODB_USERNAME=
MONGODB_PASSWORD=
APP_URL=http://localhost:5173
SERVER_URL=http://localhost:5001
GMAIL_ID=
GMAIL_PASSWORD=
JWT_TOKEN_SECRET=
# AI assistant model provider: "groq" (default, hosted) or "ollama" (local model for development)
AI_PROVIDER=
# Groq (https://console.groq.com/keys). GROQ_MODEL defaults to openai/gpt-oss-120b
GROQ_API_KEY=
GROQ_MODEL=
# Ollama (https://ollama.com). Defaults: http://localhost:11434/v1 and llama3.2:3b
OLLAMA_BASE_URL=
OLLAMA_MODEL=